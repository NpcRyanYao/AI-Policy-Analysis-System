# ===== 运行模式 =====
# snapshot: 仅使用带时间戳的本地快照（评审复现推荐）
# live:     尝试从官方站点抓取近期数据，失败时回退快照
APP_ENV=development
DATA_MODE=snapshot
SNAPSHOT_ID=2026-08-31

# ===== 服务 =====
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# SQLite 路径（相对仓库根目录或绝对路径）
DATABASE_URL=sqlite:///./data/runtime/app.db

# 管理员写操作令牌（手动补录、触发爬取、刷新分析）
# 留空则开发模式下允许无令牌写操作；生产环境必须设置
ADMIN_TOKEN=change-me-in-production

# ===== 大模型（OpenAI 兼容协议，可对接豆包/Ark）=====
# 未配置 KEY 时自动使用规则引擎兜底，系统仍可完整运行
LLM_PROVIDER=doubao
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=ep-xxxxxxxx
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ===== 采集 =====
CRAWL_ENABLED=false
CRAWL_INTERVAL_SECONDS=3
CRAWL_USER_AGENT=Mozilla/5.0 (compatible; AIPolicyTracker/1.0; +https://localhost)

# 定时任务（开发默认关闭，避免意外外网请求）
SCHEDULER_ENABLED=false
DAILY_CRAWL_CRON=0 2 * * *
DAILY_DIGEST_CRON=0 8 * * *

# ===== 邮件推送（可选，未配置则仅站内日报）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
